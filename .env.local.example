# Copy this file to .env.local (git-ignored) and fill it in.
# These values stay on the server. Never prefix them with EXPO_PUBLIC_, or they would be bundled into the app.

# ---------- Database (Supabase) ----------
# Supabase dashboard > Connect > "Session pooler" connection string (works on IPv4 networks).
# Use "Direct connection" instead if your server has IPv6. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# Optional: verify the server certificate. Download it from Database settings > SSL and give its path here.
# DATABASE_CA_CERT=./prod-ca-2021.crt
# Only for a local Postgres without SSL:
# DATABASE_SSL=disable

# Dates for daily reconciliation follow this timezone.
TZ=Africa/Nairobi

# Staff sign-in PIN (change from the demo 1234).
STAFF_PIN=

# ---------- M-Pesa via PayHero ----------
# Find these in the PayHero dashboard under API Keys and Payment Channels.
# Either paste the "Basic Auth Token" from the dashboard...
PAYHERO_AUTH_TOKEN=
# ...or give the API username and password instead.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=

# The numeric ID of the till/paybill channel that should receive the money.
PAYHERO_CHANNEL_ID=

# Optional: public HTTPS address PayHero can call when a payment finishes,
# e.g. https://your-domain.com/api/payhero/callback (or an ngrok URL while testing).
# Without it the server asks PayHero for the status every few seconds instead.
PAYHERO_CALLBACK_URL=
