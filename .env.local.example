# Copy this file to .env.local (git-ignored) for local development.
# On Netlify, add the same names under Site configuration > Environment variables (scope: Functions).
# Never prefix these with EXPO_PUBLIC_, or they would be bundled into the app.

# ---------- Database (Supabase) ----------
# Supabase dashboard > Connect.
#   Netlify Functions: use the "Transaction pooler" string (port 6543).
#   Local `npm run server`: the "Session pooler" string (port 5432) also works.
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
# Optional: verify the server certificate. Download it from Database settings > SSL and give its path here.
# DATABASE_CA_CERT=./prod-ca-2021.crt
# Only for a local Postgres without SSL:
# DATABASE_SSL=disable

# Calendar days for reconciliation and "today" on the dashboard.
APP_TIMEZONE=Africa/Nairobi

# Extra websites allowed to call the API from a browser (comma-separated).
# The Netlify site itself is allowed automatically.
# ALLOWED_ORIGINS=https://www.yourdomain.co.ke

# ---------- M-Pesa via PayHero ----------
# Find these in the PayHero dashboard under API Keys and Payment Channels.
# Either paste the "Basic Auth Token" from the dashboard...
PAYHERO_AUTH_TOKEN=
# ...or give the API username and password instead.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
# The numeric ID of the till/paybill channel that should receive the money.
PAYHERO_CHANNEL_ID=
# Optional. On Netlify it defaults to https://<your-site>/api/payhero/callback.
PAYHERO_CALLBACK_URL=
